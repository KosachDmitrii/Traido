# Traido environment — never commit real secrets

TRAIDO_ENV=development
TRAIDO_BROKER_ENV=paper
TRAIDO_TRADING_MODE=confirmation
TRAIDO_ALLOW_LIVE_TRADING=false

TRAIDO_LOG_LEVEL=INFO

TRAIDO_JOURNAL_DATABASE_URL=sqlite:///./data/traido_journal.db
# DATABASE_URL=postgresql+asyncpg://traido:traido@localhost:5432/traido

# Kill switch and caches. Without Redis the kill switch degrades to a local
# file flag: still durable, but only correct on a single node.
REDIS_URL=redis://localhost:6379/0

# API auth. A key is REQUIRED outside development; without one, /api/* is
# reachable from localhost only. Never expose the API to a network unkeyed.
TRAIDO_API_KEY=
# TRAIDO_AUTH_DISABLED=true  # tests only — refuses to apply in production

# Browsers that may call the API. Comma-separated; no wildcard in production.
TRAIDO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRAIDO_DASHBOARD_URL=http://localhost:3000

# Alpaca Paper + Market Data (primary V1 vendor)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_BROKER_BASE_URL=https://paper-api.alpaca.markets

# News + earnings calendar. REQUIRED for entries: with no key the calendar
# cannot be read, and an unread calendar is refused rather than assumed clear
# (EARNINGS_CALENDAR_NOT_CONFIGURED). To run without one, set
# risk_limits_v1.require_earnings_check=false in configs/v1_paper.json — a
# deliberate choice, recorded on every decision taken under it.
FINNHUB_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=

# Out-of-band alerts for new opportunities and kill switch flips
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend build-time API base. Empty = same-origin via the dev proxy.
VITE_API_BASE_URL=
