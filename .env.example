# Traido environment — never commit real secrets

TRAIDO_ENV=development
TRAIDO_BROKER_ENV=paper
TRAIDO_TRADING_MODE=confirmation
TRAIDO_ALLOW_LIVE_TRADING=false

# Execution broker. See docs/deploy/ibkr-gateway.md (Tailscale + Gateway on Mac).
# Local dev: TRAIDO_IBKR_HOST=127.0.0.1 when Gateway runs on this Mac.
# Railway: TRAIDO_IBKR_HOST=100.x.x.x (Mac Tailscale IP) + TAILSCALE_AUTHKEY on backend.
# TRAIDO_BROKER=ibkr
# TRAIDO_IBKR_ENV=paper
# TRAIDO_IBKR_HOST=127.0.0.1
# TRAIDO_IBKR_PORT=4002
# TRAIDO_IBKR_CLIENT_ID=1
# TRAIDO_IBKR_ACCOUNT=

TRAIDO_LOG_LEVEL=INFO

# Journal. On Railway set both to ${{Postgres.DATABASE_URL}}.
TRAIDO_JOURNAL_DATABASE_URL=sqlite:///./data/traido_journal.db
# DATABASE_URL=postgresql+asyncpg://traido:traido@localhost:5432/traido

# Kill switch and caches. On Railway: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0

# API auth. A key is REQUIRED outside development; without one, /api/* is
# reachable from localhost only. Never expose the API to a network unkeyed.
TRAIDO_API_KEY=
# TRAIDO_AUTH_DISABLED=true  # tests only — refuses to apply in production

# Browsers that may call the API. Comma-separated; no wildcard in production.
TRAIDO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRAIDO_DASHBOARD_URL=http://localhost:3000

# Alpaca Paper + Market Data (primary V1 vendor)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_BROKER_BASE_URL=https://paper-api.alpaca.markets
# Market data feed: iex (default, free) or sip (paid — matches Alpaca dashboard).
# SIP requests fall back to IEX automatically when the account returns 403.
# ALPACA_DATA_FEED=iex

# News + earnings calendar. REQUIRED for entries: with no key the calendar
# cannot be read, and an unread calendar is refused rather than assumed clear
# (EARNINGS_CALENDAR_NOT_CONFIGURED). To run without one, set
# risk_limits_v1.require_earnings_check=false in configs/v1_paper.json — a
# deliberate choice, recorded on every decision taken under it.
FINNHUB_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=

# Out-of-band alerts for new opportunities and kill switch flips
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner throughput. Deep analysis stays capped at 1 symbol regardless —
# concurrent deep paging is what burns the Alpaca data quota.
# TRAIDO_SCANNER_CONCURRENCY=2
# TRAIDO_MARKET_DATA_RPM=120
# TRAIDO_SCAN_INTERVAL_SECONDS=300
# Funnel work budgets — not candidate quality. Deep cannot exceed quant,
# and TRAIDO_MAX_LLM_CANDIDATES cannot exceed deep (Stage 3 would still stop).
# TRAIDO_QUANT_TOP_K=50
# TRAIDO_DEEP_ANALYSIS_TOP_K=40
# TRAIDO_MAX_LLM_CANDIDATES=40

# Frontend build-time API base. Empty = same-origin via the dev proxy.
# Railway frontend: VITE_API_BASE_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
VITE_API_BASE_URL=
